PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/c2dp_go_api?sslmode=disable
JWT_SECRET=change-me-for-demo
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8080

# Public test credentials only. Local binary or absolute path to c2patool.
C2PATOOL_PATH=bin/c2patool

# Used by POST /api/v1/posts/combine (../scripts/combine_signed_images.py).
# Only works when this API runs directly on the host, not via docker compose
# up --build — that image has no Python/Pillow/scripts/.
PYTHON_PATH=python3
COMBINE_SCRIPT_PATH=../scripts/combine_signed_images.py
